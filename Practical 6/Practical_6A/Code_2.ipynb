# Real-Life Example: Weather Prediction
# Find P(Rain | Cloudy=True, Humidity=High)

from pgmpy.models import DiscreteBayesianNetwork
from pgmpy.factors.discrete import TabularCPD
from pgmpy.inference import VariableElimination


# Step 1: Create Bayesian Network
model = DiscreteBayesianNetwork([
    ("Cloudy", "Rain"),
    ("Humidity", "Rain")
])


# Step 2: Probability of Cloudy weather
cpd_cloudy = TabularCPD(
    variable="Cloudy",
    variable_card=2,
    values=[[0.6], [0.4]],
    state_names={
        "Cloudy": ["False", "True"]
    }
)


# Step 3: Probability of High Humidity
cpd_humidity = TabularCPD(
    variable="Humidity",
    variable_card=2,
    values=[[0.3], [0.7]],
    state_names={
        "Humidity": ["Low", "High"]
    }
)


# Step 4: Probability of Rain
# P(Rain | Cloudy, Humidity)

cpd_rain = TabularCPD(
    variable="Rain",
    variable_card=2,
    values=[
        [0.90, 0.60, 0.40, 0.10],
        [0.10, 0.40, 0.60, 0.90]
    ],
    evidence=["Cloudy", "Humidity"],
    evidence_card=[2, 2],
    state_names={
        "Rain": ["False", "True"],
        "Cloudy": ["False", "True"],
        "Humidity": ["Low", "High"]
    }
)


# Step 5: Add CPDs to model
model.add_cpds(
    cpd_cloudy,
    cpd_humidity,
    cpd_rain
)


# Step 6: Check model
print("Is Bayesian Network valid?", model.check_model())


# Step 7: Perform inference
inference = VariableElimination(model)


# Cloudy weather + High humidity
result = inference.query(
    variables=["Rain"],
    evidence={
        "Cloudy": "True",
        "Humidity": "High"
    }
)


print("\nWeather Prediction")
print("Probability of Rain when Cloudy=True and Humidity=High:")
print(result)
