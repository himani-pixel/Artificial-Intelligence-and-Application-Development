# Real-Life Example: Weather Prediction
# Find P(Cloudy | Rain=True)

from pgmpy.models import DiscreteBayesianNetwork
from pgmpy.factors.discrete import TabularCPD
from pgmpy.inference import VariableElimination


# Step 1: Create Bayesian Network
model = DiscreteBayesianNetwork([
    ("Cloudy", "Rain")
])


# Step 2: Probability of Cloudy weather
cpd_cloudy = TabularCPD(
    variable="Cloudy",
    variable_card=2,
    values=[[0.6], [0.4]],
    state_names={
        "Cloudy": ["False", "True"]
    }
)


# Step 3: Probability of Rain
# P(Rain | Cloudy)

cpd_rain = TabularCPD(
    variable="Rain",
    variable_card=2,
    values=[
        [0.90, 0.40],
        [0.10, 0.60]
    ],
    evidence=["Cloudy"],
    evidence_card=[2],
    state_names={
        "Rain": ["False", "True"],
        "Cloudy": ["False", "True"]
    }
)


# Step 4: Add CPDs
model.add_cpds(
    cpd_cloudy,
    cpd_rain
)


# Step 5: Check model
print("Is Bayesian Network valid?", model.check_model())


# Step 6: Perform inference
inference = VariableElimination(model)


# Rain is observed
result = inference.query(
    variables=["Cloudy"],
    evidence={
        "Rain": "True"
    }
)


print("\nWeather Prediction")
print("Posterior Probability:")
print("P(Cloudy | Rain=True)")
print(result)
